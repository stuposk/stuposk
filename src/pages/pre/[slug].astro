---
// Aktuálna (najnovšia) verzia výstupu – stále ten istý link.
import ShareView from '../../components/ShareView.astro';
import { getShares, type Share } from '../../lib/content';

export async function getStaticPaths() {
  return (await getShares()).map((share) => ({ params: { slug: share.id }, props: { share } }));
}
const { share } = Astro.props as { share: Share };
---
<ShareView share={share} entry={share.latest} />
