---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, expertise, projects, timeline } from '../data/site';

// krátky „commit hash“ odvodený z textu, aby sa nemenil medzi buildmi
const hash = (s: string) => {
  let h = 5381;
  for (const ch of s) h = ((h << 5) + h + ch.charCodeAt(0)) >>> 0;
  return h.toString(16).padStart(7, '0').slice(0, 7);
};
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const log = [...timeline].reverse();
---
<Base>
  <Header />
  <main class="wrap">
    <section class="hero">
      <p class="cmd">./hello</p>
      <h1>Hello, world.<span class="cursor" aria-hidden="true">_</span></h1>
      <p class="who">Som <b>{site.name}</b> <span class="c">(aka {site.handle})</span>. {site.tagline}</p>
      {site.intro.map((line) => <p class="c">// {line}</p>)}
    </section>

    <section>
      <h2 class="cmd">cat <b>skills.json</b></h2>
      <pre class="json"><code>{'{\n'}{expertise.map((e, i) => (
<Fragment>  <span class="a">"{e.title}"</span>: <span class="s">"{e.text}"</span>{i < expertise.length - 1 ? ',' : ''}{'\n'}</Fragment>
))}{'}'}</code></pre>
    </section>

    <section id="projekty">
      <h2 class="cmd">ls <b>~/projects</b></h2>
      <ul class="proj">
        {projects.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener">
              <span class="pn">{p.name}/</span>
              <span class="pt">{p.text}</span>
              <span class="ph c">{p.host} ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="log">
      <h2 class="cmd">git log <b>--oneline</b></h2>
      <ol class="log">
        {log.map((t, i) => (
          <li class={t.kind}>
            <span class="hash">{t.year === 'HEAD' ? 'HEAD' : hash(t.year + t.title)}</span>
            <span class="year c">{t.year === 'HEAD' ? 'now' : t.year}</span>
            <div><span class="msg">{t.title}</span>{i === 0 && <span class="ref"> (HEAD -&gt; main)</span>}<p class="c">{t.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    {posts.length > 0 && (
      <section>
        <h2 class="cmd">ls -t <b>blog/</b></h2>
        <ul class="posts">
          {posts.map((p) => (
            <li><a href={`/blog/${p.id}`}><time class="c" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><span>{p.data.title}</span></a></li>
          ))}
        </ul>
        <p><a href="/blog" class="c">cd blog/ →</a></p>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .hero { padding-top: 4.5rem; }
  h1 { font-size: clamp(2.25rem, 9vw, 4rem); letter-spacing: -0.03em; margin: 0 0 1.5rem; }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  .who { font-size: 1.0625rem; margin: 0 0 .75rem; }
  .hero .c { margin: 0; }

  .json { margin: 0; padding: 1.25rem; background: color-mix(in srgb, var(--line) 45%, transparent); border: 1px solid var(--line); border-radius: 6px; overflow-x: auto; font: inherit; font-size: .875rem; line-height: 1.8; white-space: pre-wrap; }

  ul, ol { list-style: none; padding: 0; margin: 0; }
  .proj a { display: grid; grid-template-columns: 8rem 1fr auto; gap: 1rem; padding: .9rem 0; border-bottom: 1px dashed var(--line); text-decoration: none; }
  .pn { font-weight: 600; color: var(--accent); }
  .pt { color: var(--muted); }
  .ph { font-size: .8125rem; white-space: nowrap; }
  .proj a:hover .pt { color: var(--fg); }
  @media (max-width: 38rem) { .proj a { grid-template-columns: 1fr auto; gap: .25rem 1rem; } .pt { grid-column: 1 / -1; grid-row: 2; } }

  .log li { display: grid; grid-template-columns: 4.5rem 3.5rem 1fr; gap: .75rem; padding: .5rem 0; }
  .hash { color: var(--string); }
  .msg { font-weight: 600; }
  .ref { color: var(--accent); font-size: .8125rem; }
  .log p { margin: .1rem 0 0; font-size: .875rem; }
  @media (max-width: 34rem) { .log li { grid-template-columns: 4.5rem 1fr; } .log .year { display: none; } }

  .posts a { display: flex; gap: 1.25rem; padding: .6rem 0; text-decoration: none; }
  .posts a:hover span { color: var(--accent); }
  @media (max-width: 34rem) { .posts a { flex-direction: column; gap: 0; } }
</style>
