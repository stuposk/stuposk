---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="404">
  <Header />
  <main class="wrap">
    <div class="only-human">
      <h1>404</h1>
      <p class="msg">Táto stránka tu nie je. Možno nikdy nebola.</p>
      <p><a href="/">← Späť domov</a></p>
    </div>
    <div class="only-dev dev">
      <p class="cmd">cd {Astro.url.pathname}</p>
      <h1>404</h1>
      <p class="c">// bash: cd: no such file or directory</p>
      <p class="c">// na mojom stroji to fungovalo.</p>
      <p><a href="/">cd ~</a></p>
    </div>
  </main>
</Base>
<style>
  main { padding-top: 5rem; padding-bottom: 8rem; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(6rem, 30vw, 14rem); line-height: .85; color: var(--accent); margin: 0 0 1.5rem; }
  .msg { font-family: var(--serif); font-size: 1.75rem; margin: 0 0 1.5rem; }
  .dev h1 { font-family: var(--mono); font-weight: 600; font-size: clamp(4rem, 20vw, 8rem); }
  .dev p { margin: 0 0 .25rem; font-family: var(--mono); }
</style>
