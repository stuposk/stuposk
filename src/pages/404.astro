---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="404">
  <Header />
  <main class="wrap">
    <p class="cmd">cd {Astro.url.pathname}</p>
    <h1>404</h1>
    <p class="c">// bash: cd: no such file or directory</p>
    <p class="c">// na mojom stroji to fungovalo.</p>
    <p><a href="/">cd ~</a></p>
  </main>
</Base>
<style>
  main { padding-top: 5rem; padding-bottom: 5rem; }
  h1 { font-size: clamp(4rem, 20vw, 8rem); color: var(--accent); margin: 0 0 1rem; }
  p { margin: 0 0 .25rem; }
</style>
