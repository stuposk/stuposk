---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const iso = (d: Date) => d.toISOString().slice(0, 10);
const human = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog" description="Texty o AI, programovaní, podnikaní a komunite.">
  <Header />
  <main class="wrap">
    <p class="cmd only-dev">ls -t <b>blog/</b></p>
    <h1><span class="only-human">Blog</span><span class="only-dev">blog/</span></h1>
    <ul>
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>
            <time datetime={p.data.date.toISOString()}><span class="only-human">{human.format(p.data.date)}</span><span class="only-dev">{iso(p.data.date)}</span></time>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Base>
<style>
  main { padding-top: 4rem; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(4rem, 16vw, 8rem); line-height: .9; letter-spacing: -0.03em; margin: 0 0 3rem; }
  :global([data-mode='dev']) h1 { font-family: var(--mono); font-weight: 600; font-size: clamp(2rem, 8vw, 3rem); margin-bottom: 1.5rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  a { display: block; padding: 1.5rem 0; border-top: 1px solid var(--line); text-decoration: none; }
  :global([data-mode='dev']) a { border-top-style: dashed; padding: 1.25rem 0; }
  time { font-size: .8125rem; color: var(--muted); }
  h2 { font-family: var(--serif); font-weight: 400; font-size: 2rem; line-height: 1.15; margin: .25rem 0 .35rem; }
  :global([data-mode='dev']) h2 { font-family: var(--mono); font-weight: 600; font-size: 1.125rem; }
  a:hover h2 { color: var(--accent); }
  p { margin: 0; color: var(--muted); font-size: .9375rem; }
</style>
