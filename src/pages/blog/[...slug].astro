---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toISOString().slice(0, 10);
---
<Base title={post.data.title} description={post.data.description}>
  <Header />
  <main class="wrap">
    <article>
      <p class="cmd">cat <b>blog/{post.id}.md</b></p>
      <time class="c" datetime={post.data.date.toISOString()}>{date}</time>
      <h1>{post.data.title}</h1>
      <div class="prose"><Content /></div>
    </article>
    <p class="back"><a href="/blog" class="c">cd .. ←</a></p>
  </main>
  <Footer />
</Base>
<style>
  article { padding-top: 3rem; }
  h1 { font-size: clamp(1.75rem, 6vw, 2.5rem); letter-spacing: -0.02em; margin: .5rem 0 2rem; }
  .prose { font: 1.0625rem/1.75 var(--sans); max-width: 40rem; }
  .prose :global(h2) { font-family: var(--mono); font-size: 1.25rem; margin: 2.5rem 0 .75rem; }
  .prose :global(h2)::before { content: '## '; color: var(--accent); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(blockquote) { margin: 1.5rem 0; padding-left: 1rem; border-left: 2px solid var(--accent); color: var(--muted); }
  .prose :global(code) { font-family: var(--mono); font-size: .875em; background: var(--line); padding: .1em .35em; border-radius: 4px; }
  .prose :global(pre) { font-family: var(--mono); font-size: .875rem; background: var(--line); padding: 1rem; overflow-x: auto; border-radius: 6px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(img) { max-width: 100%; }
  .back { margin: 3rem 0 0; }
</style>
