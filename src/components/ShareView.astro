---
// Zobrazenie jedného výstupu pre adresáta (aktuálna alebo staršia verzia).
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Prose from './Prose.astro';
import DocSidebar from './DocSidebar.astro';
import PoweredBy from './PoweredBy.astro';
import { humanDate, isoDate, type Share, type Version } from '../lib/content';

interface Props { share: Share; entry: Version }
const { share, entry } = Astro.props;
const { recipient, related, versions, latest } = share;
const isLatest = entry.n === latest.n;
const { Content, headings } = await render(entry);
const base = `/pre/${share.id}`;
const md = isLatest ? `${base}.md` : `${base}/v${entry.n}.md`;
const { status, validUntil } = entry.data;
const expired = validUntil ? validUntil.getTime() < Date.now() : false;
const canonical = new URL(base, Astro.site).href;
---
<Base title={entry.data.title} description={entry.data.description} noindex md={md}>
  <Header />
  <main class="wrap doc">
    <article>
      {!isLatest && (
        <a class="old no-print" href={base}>
          <span class="only-human">Pozeráš staršiu verziu v{entry.n}. Aktuálna je <b>v{latest.n}</b> →</span>
          <span class="only-dev">// detached HEAD: v{entry.n}. git checkout v{latest.n} →</span>
        </a>
      )}
      <p class="cmd only-dev">cat <b>~/shared/{share.id}/v{entry.n}.md</b></p>
      <div class="badge">
        <span class="only-human">{recipient ? `Pripravené pre ${recipient}` : 'Pripravené pre teba'}</span>
        <span class="only-dev">// for: {recipient ?? 'you'}</span>
        <span class="sep">·</span>
        <span>v{entry.n}</span>
        <span class="sep">·</span>
        <time datetime={entry.data.date.toISOString()}><span class="only-human">{humanDate(entry.data.date)}</span><span class="only-dev">{isoDate(entry.data.date)}</span></time>
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="lede">{entry.data.description}</p>}
      {entry.data.changes && entry.n > 1 && (
        <p class="changes"><b><span class="only-human">Čo je nové vo v{entry.n}:</span><span class="only-dev">// diff v{entry.n - 1}..v{entry.n}:</span></b> {entry.data.changes}</p>
      )}
      <a class="jump no-print" href="#panel"><span class="only-human">Obsah a stiahnutie ↓</span><span class="only-dev">// toc &amp; export ↓</span></a>
      <Prose><Content /></Prose>
      <aside class="from no-print">
        <img src="/logo.svg" alt="" width="40" height="40" />
        <p><b>Michal Stupák</b><br /><span>Otázky? Odpíš na mail alebo napíš na <a href="mailto:hello@michalstupak.com">hello@michalstupak.com</a>.</span></p>
        <PoweredBy />
      </aside>
      <p class="print-only">Michal Stupák · hello@michalstupak.com · {canonical} · v{entry.n}<br /><PoweredBy variant="print" /></p>
    </article>

    <DocSidebar
      metaLabel="O dokumente"
      meta={[
        { label: 'Stav', value: status, className: `status ${status.replace(' ', '-')}` },
        { label: 'Verzia', value: `v${entry.n}${isLatest ? '' : ` z ${latest.n}`}` },
        { label: 'Dátum', value: isoDate(entry.data.date) },
        ...(validUntil ? [{ label: 'Platí do', value: isoDate(validUntil) + (expired ? ' (vypršalo)' : ''), className: expired ? 'expired' : undefined }] : []),
      ]}
      headings={headings}
      md={md}
      filename={`${share.id}-v${entry.n}.md`}
      title={entry.data.title}
      kolega
    >
      <Fragment slot="after">
        {versions.length > 1 && (
          <div class="block list">
            <p class="label"><span class="only-human">Verzie</span><span class="only-dev">// git log</span></p>
            <ol>
              {[...versions].reverse().map((v) => (
                <li>
                  <a href={v.n === latest.n ? base : `${base}/v${v.n}`} aria-current={v.n === entry.n ? 'page' : undefined}>
                    <span class="t">v{v.n}{v.n === latest.n && <em> · aktuálna</em>}</span>
                    <span class="d">{isoDate(v.data.date)}{v.data.changes && v.n > 1 ? ` · ${v.data.changes}` : ''}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
        {related.length > 0 && (
          <div class="block list">
            <p class="label"><span class="only-human">Ďalšie výstupy pre teba</span><span class="only-dev">// ls ~/shared/</span></p>
            <ul>
              {related.map((r) => (
                <li><a href={`/pre/${r.id}`}><span class="t">{r.latest.data.title}</span><span class="d">{isoDate(r.latest.data.date)} · v{r.latest.n} · {r.latest.data.status}</span></a></li>
              ))}
            </ul>
          </div>
        )}
      </Fragment>
    </DocSidebar>
  </main>
  <Footer />
</Base>

<style>
  article { padding-top: 4rem; padding-bottom: 2rem; }
  .old { display: block; margin: 0 0 2rem; padding: .75rem 1rem; border: 1px solid var(--accent); border-radius: 10px; color: var(--accent); text-decoration: none; font-size: .9375rem; }
  :global([data-mode='dev']) .old { border-radius: 4px; font-family: var(--mono); font-size: .8125rem; }
  .old:hover { background: var(--soft); }
  .badge { display: inline-flex; flex-wrap: wrap; gap: .4rem; font-size: .8125rem; color: var(--muted); padding: .35rem .8rem; border: 1px solid var(--line); border-radius: 999px; }
  :global([data-mode='dev']) .badge { border: 0; padding: 0; font-family: var(--mono); color: var(--comment); }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.5rem, 7vw, 4rem); line-height: 1.02; letter-spacing: -0.02em; margin: 1.25rem 0 1rem; }
  :global([data-mode='dev']) h1 { font-family: var(--mono); font-weight: 600; font-size: clamp(1.75rem, 6vw, 2.5rem); line-height: 1.25; }
  .lede { font-family: var(--serif); font-size: 1.375rem; line-height: 1.35; color: var(--muted); margin: 0 0 2rem; }
  :global([data-mode='dev']) .lede { font-family: var(--mono); font-size: .9375rem; }
  .changes { margin: 0 0 2.5rem; padding: .75rem 1rem; background: var(--soft); border-left: 2px solid var(--accent); font-size: .9375rem; }
  :global([data-mode='dev']) .changes { font-family: var(--mono); font-size: .8125rem; }
  .from { display: flex; gap: 1rem; align-items: center; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: .9375rem; }
  .from img { outline: 1px solid var(--line); }
  .from p { margin: 0; flex: 1; }
  .from > :global(.kolega) { align-self: flex-end; }
  .print-only { display: none; }

  .doc :global(.status) { display: inline-block; padding: .1rem .55rem; border-radius: 999px; font-size: .75rem; border: 1px solid currentColor; }
  .doc :global(.status.návrh) { color: var(--muted); }
  .doc :global(.status.na-pripomienky) { color: var(--string); }
  .doc :global(.status.finálne) { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  .doc :global(.expired) { color: var(--accent); }

  .list { border-top: 1px solid var(--line); padding-top: .9rem; }
  .list .label { display: block; margin: 0 0 .6rem; font-size: .6875rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  :global([data-mode='dev']) .list .label { text-transform: none; letter-spacing: 0; font-size: .8125rem; color: var(--comment); font-family: var(--mono); }
  .list ul, .list ol { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .list a { display: grid; gap: .1rem; text-decoration: none; padding: .5rem .75rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); transition: border-color .2s; }
  :global([data-mode='dev']) .list a { border-radius: 4px; }
  .list a:hover, .list a[aria-current='page'] { border-color: var(--accent); }
  .list .t { line-height: 1.3; }
  .list .t em { font-style: normal; color: var(--accent); font-size: .75rem; }
  .list a:hover .t { color: var(--accent); }
  .list .d { font-size: .75rem; color: var(--muted); line-height: 1.35; }

  @media print {
    .lede { margin-bottom: 2rem; }
    .print-only { display: block; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 9pt; color: var(--muted); }
  }
</style>
