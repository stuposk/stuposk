---
import { site, expertise, projects, timeline } from '../data/site';
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; posts: { id: string; data: { title: string; description: string; date: Date } }[] }
const { lang, posts } = Astro.props;
const tr = t(lang);
const fmt = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
const [first, ...rest] = site.name.split(' ');
---
<div class="only-human human">
  <section class="hero wrap">
    <p class="eyebrow">Martin · Slovensko</p>
    <h1>{first}<br /><em>{rest.join(' ')}</em><span class="dot">.</span></h1>
    <div class="hero-foot">
      <p class="lead">{site.tagline} {site.intro[0]}</p>
      <dl class="now">
        <dt class="eyebrow">{tr('home.now')}</dt>
        {site.roles.map((r) => <dd><span>{r.role}</span><b>{r.org}</b></dd>)}
      </dl>
    </div>
  </section>

  <section class="wrap">
    <div class="head"><h2>{tr('home.expertise')}</h2></div>
    <ol class="exp">
      {expertise.map((e, i) => (
        <li><span class="n">0{i + 1}</span><h3>{e.title}</h3><p>{e.text}</p></li>
      ))}
    </ol>
  </section>

  <section id="projekty" class="wrap">
    <div class="head"><h2>{tr('home.projects')}</h2></div>
    <ul class="proj">
      {projects.map((p) => (
        <li>
          <a href={p.href} target="_blank" rel="noopener">
            <span class="pn">{p.name}</span>
            <span class="pt">{p.text}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="cesta" class="wrap">
    <div class="head"><h2>{tr('home.path')}</h2><span class="eyebrow">{tr('home.path.sub')}</span></div>
    <ol class="tl">
      {timeline.map((e) => (
        <li class={e.kind}>
          <span class="year">{e.year}</span>
          <div><h3>{e.title}</h3><p>{e.text}</p></div>
        </li>
      ))}
    </ol>
  </section>

  {posts.length > 0 && (
    <section class="wrap">
      <div class="head"><h2>{tr('home.blog')}</h2><a class="eyebrow" href="/blog">{tr('home.blog.all')} →</a></div>
      <ul class="posts">
        {posts.map((p) => (
          <li><a href={`/blog/${p.id}`}><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time><span class="pt2">{p.data.title}</span><span class="desc">{p.data.description}</span></a></li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
  .human section { padding-top: 7rem; }
  .human .hero { padding-top: 4rem; }
  h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(4.5rem, 19vw, 10.5rem); line-height: .86; letter-spacing: -0.035em; margin: 1.25rem 0 3rem; }
  h1 em { font-style: italic; padding-left: .12em; }
  .dot { color: var(--accent); }
  .hero-foot { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2.5rem; align-items: end; }
  .lead { font-family: var(--serif); font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; margin: 0; }
  .now { margin: 0; border-top: 1px solid var(--fg); padding-top: .75rem; }
  .now dt { margin-bottom: .5rem; }
  .now dd { margin: 0; display: flex; justify-content: space-between; gap: 1rem; padding: .35rem 0; border-bottom: 1px solid var(--line); font-size: .875rem; }
  .now dd span { color: var(--muted); }
  .now dd b { font-weight: 600; white-space: nowrap; }
  @media (max-width: 40rem) { .hero-foot { grid-template-columns: 1fr; } }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2.5rem; }
  h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.5rem, 8vw, 3.75rem); line-height: 1; letter-spacing: -0.02em; }
  .head a { text-decoration: none; }

  ul, ol { list-style: none; padding: 0; margin: 0; }
  .exp { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 2.5rem; }
  .exp li { border-top: 1px solid var(--fg); padding: 1rem 0 2rem; }
  .exp .n { font-size: .75rem; color: var(--accent); font-weight: 600; }
  .exp h3, .tl h3 { font-family: var(--serif); font-weight: 400; font-size: 1.75rem; line-height: 1.1; margin: .5rem 0; }
  .exp p, .tl p { margin: 0; color: var(--muted); }
  @media (max-width: 34rem) { .exp { grid-template-columns: 1fr; } }

  .proj { border-top: 1px solid var(--fg); }
  .proj a { position: relative; display: grid; grid-template-columns: minmax(9rem, 1fr) 1.3fr auto; gap: 1.5rem; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: padding .3s ease, background-color .3s ease; }
  .proj a:hover { padding-left: 1rem; padding-right: 1rem; background: var(--soft); color: inherit; }
  .pn { font-family: var(--serif); font-size: clamp(2rem, 6vw, 2.75rem); line-height: 1; }
  .proj a:hover .pn { color: var(--accent); font-style: italic; }
  .pt { color: var(--muted); font-size: .9375rem; }
  .arrow { font-size: 1.25rem; transition: transform .3s; }
  .proj a:hover .arrow { transform: translate(4px, -4px); color: var(--accent); }
  @media (max-width: 38rem) { .proj a { grid-template-columns: 1fr auto; gap: .25rem 1rem; } .pt { grid-column: 1 / -1; grid-row: 2; } }

  .tl li { display: grid; grid-template-columns: 9rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .year { font-family: var(--serif); font-size: clamp(2.5rem, 7vw, 3.5rem); line-height: .9; color: transparent; -webkit-text-stroke: 1px var(--muted); }
  .tl li.project .year { -webkit-text-stroke-color: var(--accent); }
  .tl li:hover .year { color: var(--accent); -webkit-text-stroke-color: var(--accent); }
  .tl h3 { margin-top: 0; }
  @media (max-width: 34rem) { .tl li { grid-template-columns: 1fr; gap: .5rem; } }

  .posts a { display: grid; grid-template-columns: 10rem 1fr; gap: .25rem 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--line); text-decoration: none; }
  .posts time { color: var(--muted); font-size: .875rem; padding-top: .35rem; grid-row: span 2; }
  .pt2 { font-family: var(--serif); font-size: 1.75rem; line-height: 1.15; }
  .posts a:hover .pt2 { color: var(--accent); }
  .desc { color: var(--muted); font-size: .9375rem; }
  @media (max-width: 34rem) { .posts a { grid-template-columns: 1fr; } .posts time { grid-row: auto; } }
</style>
