---
<div class="prose"><slot /></div>
<style>
  .prose { font: 1.125rem/1.75 var(--prose); max-width: 40rem; }
  .prose :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 2rem; line-height: 1.15; margin: 2.5rem 0 .75rem; }
  .prose :global(h3) { font-size: 1.125rem; margin: 2rem 0 .5rem; }
  :global([data-mode='dev']) .prose :global(h2) { font-family: var(--mono); font-weight: 600; font-size: 1.25rem; }
  :global([data-mode='dev']) .prose :global(h2)::before { content: '## '; color: var(--accent); }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(table) { margin: 0 0 1.25rem; }
  .prose :global(li) { margin-bottom: .35rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(blockquote) { margin: 2rem 0; padding-left: 1.25rem; border-left: 2px solid var(--accent); font-family: var(--serif); font-size: 1.5rem; line-height: 1.3; }
  :global([data-mode='dev']) .prose :global(blockquote) { font-family: inherit; font-size: inherit; color: var(--muted); }
  .prose :global(code) { font-family: var(--mono); font-size: .85em; background: var(--soft); padding: .1em .35em; border-radius: 4px; }
  .prose :global(pre) { font-family: var(--mono); font-size: .875rem; background: var(--soft); border: 1px solid var(--line); padding: 1rem; overflow-x: auto; border-radius: 6px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(img) { max-width: 100%; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: .9375rem; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid var(--line); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
</style>
