---
import { site } from '../data/site';
---
<footer id="kontakt" class="wrap foot">
  <h2 class="cmd">ping <b>{site.email}</b></h2>
  <p class="mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
  <ul>
    <li><a href={site.links.linkedin} rel="me noopener">linkedin</a></li>
    <li><a href={site.links.instagram} rel="me noopener">instagram</a></li>
    <li><a href="/rss.xml">rss</a></li>
  </ul>
  <p class="c">// © {new Date().getFullYear()} {site.name} · žiadne cookies, žiadne trackery<br />// <span class="a">exit 0</span></p>
</footer>
<style>
  .foot { padding-top: 4rem; padding-bottom: 3rem; }
  .mail { font-size: clamp(1.25rem, 5vw, 2rem); font-weight: 600; margin: 0 0 1rem; word-break: break-all; }
  ul { list-style: none; display: flex; gap: 1.25rem; padding: 0; margin: 0 0 2.5rem; }
  .c { font-size: .8125rem; }
</style>
